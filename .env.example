# Local sample configuration for the starter-kit demo.
# Copy values into your shell or a local .env file if your tooling loads one.
# The repository ignores .env so machine-specific overrides and real keys stay local.

ASPNETCORE_ENVIRONMENT=Development

# Docker Compose PostgreSQL defaults. These are local-only demo credentials.
# appsettings.json intentionally omits this connection string; supply it through
# a local .env file, shell variables or user secrets.
POSTGRES_DB=genai_platform
POSTGRES_USER=genai
POSTGRES_PASSWORD=genai_dev_password

# Shared by API, Worker and Evaluation CLI. Set DocumentStorage RootPath to one
# absolute filesystem path in both API and Worker terminals. Docker Compose only
# starts PostgreSQL and cannot configure either host process.
ConnectionStrings__GenAIPlatform=Host=localhost;Port=5432;Database=genai_platform;Username=genai;Password=genai_dev_password
GenAIPlatform__Postgres__ConnectionStringName=GenAIPlatform
GenAIPlatform__DocumentStorage__RootPath=E:\genai-platform-storage\documents

# Mock providers are the default and do not call real LLM or embedding services.
GenAIPlatform__ModelGateway__Provider=Mock
GenAIPlatform__ModelGateway__DefaultModel=mock-chat
GenAIPlatform__ModelGateway__StrongModel=mock-chat-strong
GenAIPlatform__ModelGateway__CheapModel=mock-chat-cheap
GenAIPlatform__ModelGateway__EvaluationModel=mock-chat-evaluation
GenAIPlatform__Embeddings__Provider=Mock
GenAIPlatform__Embeddings__DefaultModel=mock-embedding

# Prompt/body logging remains disabled by default for privacy.

# AI request log persistence defaults to fail-open telemetry. Set FailClosed when
# durable AI request logs must block user-facing model calls on write failure.
GenAIPlatform__Observability__AiRequestLogging__FailureMode=FailOpen

# Demo header auth defaults are for Development quickstart only.
# Non-development opt-in requires an explicit X-Demo-User-Id request header.
GenAIPlatform__DemoAuth__Enabled=true
GenAIPlatform__DemoAuth__AllowInNonDevelopment=false

# Optional real-provider overrides. Leave blank for the public demo path.
# GenAIPlatform__ModelGateway__Provider=OpenAiCompatible
# GenAIPlatform__ModelGateway__OpenAiCompatible__BaseUrl=https://api.openai.com
# GenAIPlatform__ModelGateway__OpenAiCompatible__ApiKey=
# GenAIPlatform__Embeddings__Provider=OpenAiCompatible
# GenAIPlatform__Embeddings__OpenAiCompatible__BaseUrl=https://api.openai.com
# GenAIPlatform__Embeddings__OpenAiCompatible__ApiKey=
