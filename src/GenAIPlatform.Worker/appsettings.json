{
  "GenAIPlatform": {
    "DocumentIngestion": {
      "MaxUploadBytes": 2097152,
      "AllowedExtensions": [ ".txt", ".md" ],
      "ChunkMaxCharacters": 1200,
      "ChunkOverlapCharacters": 150,
      "ChunkingProfile": "plain-text",
      "ChunkingProfileVersion": "v1",
      "MaxIndexingAttempts": 3,
      "IndexingRetryDelaySeconds": 30,
      "MaxStorageCleanupAttempts": 3,
      "StorageCleanupRetryDelaySeconds": 30,
      "MaxIndexingJobsPerPoll": 5,
      "MaxStorageCleanupRequestsPerPoll": 5,
      "ProcessingJobLeaseSeconds": 900,
      "WorkerPollIntervalSeconds": 30
    },
    "DocumentStorage": {
      "RootPath": "storage/documents"
    },
    "Postgres": {
      "ConnectionStringName": "GenAIPlatform"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
