{
  "GenAIPlatform": {
    "Application": {
      "ApiVersion": "v1",
      "RunnerVersion": "0.4.0"
    },
    "Observability": {
      "AiRequestLogging": {
        "FailureMode": "FailOpen"
      }
    },
    "ModelGateway": {
      "Provider": "Mock",
      "DefaultModel": "mock-chat",
      "StrongModel": "mock-chat-strong",
      "CheapModel": "mock-chat-cheap",
      "EvaluationModel": "mock-chat-evaluation",
      "DefaultTemperature": 0.2,
      "DefaultMaxOutputTokens": 512,
      "MaxInputMessageCharacters": 8000,
      "AllowedModels": [],
      "MinTemperature": 0,
      "MaxTemperature": 1,
      "MaxOutputTokensLimit": 2048,
      "MaxCorrelationIdLength": 128,
      "OpenAiCompatible": {
        "BaseUrl": "https://api.openai.com",
        "ChatCompletionsPath": "/v1/chat/completions",
        "TimeoutSeconds": 30,
        "MaxRetryAttempts": 2,
        "RetryBaseDelayMilliseconds": 200,
        "AllowInsecureHttpForLoopback": false
      }
    },
    "Embeddings": {
      "Provider": "Mock",
      "DefaultModel": "mock-embedding",
      "MockDimensions": 16,
      "MaxInputCharacters": 8000,
      "OpenAiCompatible": {
        "BaseUrl": "https://api.openai.com",
        "EmbeddingsPath": "/v1/embeddings",
        "TimeoutSeconds": 30,
        "MaxRetryAttempts": 2,
        "RetryBaseDelayMilliseconds": 200,
        "AllowInsecureHttpForLoopback": false
      }
    },
    "Rag": {
      "DefaultTopK": 5,
      "MaxTopK": 20,
      "DefaultMinSimilarityScore": 0.2,
      "MaxDocumentFilters": 50,
      "MaxContextCharacters": 6000,
      "NoContextFallbackMessage": "I could not find relevant document context for that question."
    },
    "AgenticChat": {
      "MaxSteps": 4,
      "TimeoutSeconds": 15,
      "MaxToolCalls": 8,
      "MaxTotalTokens": 4096,
      "MaxEstimatedCost": 0.05,
      "EstimatedCostPerThousandTokens": 0.001,
      "PolicyVersion": "tool-policy-v1"
    },
    "DocumentIngestion": {
      "MaxUploadBytes": 2097152,
      "AllowedExtensions": [ ".txt", ".md" ],
      "ChunkMaxCharacters": 1200,
      "ChunkOverlapCharacters": 150,
      "ChunkingProfile": "plain-text",
      "ChunkingProfileVersion": "v1",
      "MaxIndexingAttempts": 3,
      "IndexingRetryDelaySeconds": 30,
      "MaxStorageCleanupAttempts": 3,
      "StorageCleanupRetryDelaySeconds": 30,
      "MaxIndexingJobsPerPoll": 5,
      "MaxStorageCleanupRequestsPerPoll": 5,
      "ProcessingJobLeaseSeconds": 900,
      "WorkerPollIntervalSeconds": 30
    },
    "DocumentStorage": {
      "RootPath": "storage/documents"
    },
    "DemoAuth": {
      "Enabled": false,
      "AllowInNonDevelopment": false,
      "DefaultUserId": "demo-user",
      "DefaultTenantId": "demo-tenant",
      "DefaultRoles": [ "developer" ],
      "DefaultGroups": [ "demo" ]
    },
    "Postgres": {
      "ConnectionStringName": "GenAIPlatform"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
