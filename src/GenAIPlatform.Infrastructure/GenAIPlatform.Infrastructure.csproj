<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GenAIPlatform.Application.Agentic\GenAIPlatform.Application.Agentic.csproj" />
    <ProjectReference Include="..\GenAIPlatform.Application.Core\GenAIPlatform.Application.Core.csproj" />
    <ProjectReference Include="..\GenAIPlatform.Application.Evaluations\GenAIPlatform.Application.Evaluations.csproj" />
    <ProjectReference Include="..\GenAIPlatform.Application.Generation\GenAIPlatform.Application.Generation.csproj" />
    <ProjectReference Include="..\GenAIPlatform.Application.Knowledge\GenAIPlatform.Application.Knowledge.csproj" />
    <ProjectReference Include="..\GenAIPlatform.Application.Usage\GenAIPlatform.Application.Usage.csproj" />
    <ProjectReference Include="..\GenAIPlatform.Domain\GenAIPlatform.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Pgvector" />
  </ItemGroup>

  <!-- Migration SQL and the frozen legacy baseline ship inside the assembly so a published host
       can migrate without the checkout directory. Logical names are explicit so a resource rename
       is a deliberate change rather than an MSBuild naming side effect. -->
  <ItemGroup>
    <EmbeddedResource Include="Migrations\Sql\migrations.manifest" LogicalName="GenAIPlatform.Infrastructure.Migrations.Sql.migrations.manifest" />
    <EmbeddedResource Include="Migrations\Sql\*.sql" LogicalName="GenAIPlatform.Infrastructure.Migrations.Sql.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Migrations\Fingerprints\*.txt" LogicalName="GenAIPlatform.Infrastructure.Migrations.Fingerprints.%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
