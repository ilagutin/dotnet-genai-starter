    },
    "/api/v1/chat/agentic": {
      "post": {
        "tags": [
          "v1"
        ],
        "summary": "Run an agentic chat completion: the model may propose backend tool calls subject to policy.",
        "operationId": "CreateAgenticChatCompletion",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgenticChatHttpRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
