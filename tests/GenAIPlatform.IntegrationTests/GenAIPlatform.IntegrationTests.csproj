<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Integration tests suppress xUnit1051 because host/client APIs expose many optional tokens;
         cancellation-sensitive paths pass TestContext.Current.CancellationToken explicitly. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.mcp.test.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Baselines\openapi-v1.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GenAIPlatform.Application.Agentic\GenAIPlatform.Application.Agentic.csproj" />
    <ProjectReference Include="..\..\src\GenAIPlatform.Application.Core\GenAIPlatform.Application.Core.csproj" />
    <ProjectReference Include="..\..\src\GenAIPlatform.Application.Evaluations\GenAIPlatform.Application.Evaluations.csproj" />
    <ProjectReference Include="..\..\src\GenAIPlatform.Application.Generation\GenAIPlatform.Application.Generation.csproj" />
    <ProjectReference Include="..\..\src\GenAIPlatform.Application.Knowledge\GenAIPlatform.Application.Knowledge.csproj" />
    <ProjectReference Include="..\..\src\GenAIPlatform.Application.Usage\GenAIPlatform.Application.Usage.csproj" />
    <ProjectReference Include="..\..\src\GenAIPlatform.Api\GenAIPlatform.Api.csproj" />
    <ProjectReference Include="..\..\src\GenAIPlatform.Evaluations\GenAIPlatform.Evaluations.csproj" />
    <ProjectReference Include="..\..\src\GenAIPlatform.Infrastructure\GenAIPlatform.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\GenAIPlatform.Mcp\GenAIPlatform.Mcp.csproj" Aliases="McpHost" />
    <ProjectReference Include="..\..\src\GenAIPlatform.Worker\GenAIPlatform.Worker.csproj" />
  </ItemGroup>

</Project>
